# ---------------------------------------------------------------------------
# Copy to .env and fill in. .env is git-ignored and never committed.
#
# Every placeholder is written <<UPPER_SNAKE_CASE>>. No example value here is
# secret-shaped: nothing should look like a real credential to a scanner or to
# a reader.
#
# Classification:
#   Secret                 never committed, never logged
#   Sensitive non-secret   name and placeholder only
#   Safe                   real defaults, may be logged
# ---------------------------------------------------------------------------

# --- container images. Safe. Pinned by tag AND digest. ---------------------
# Capture with: docker image inspect --format '{{index .RepoDigests 0}}' <image>
# Record tag, digest and capture date in docs/change-control.md.
POSTGRES_IMAGE=postgres:<<POSTGRES_PATCH_TAG>>@sha256:<<POSTGRES_IMAGE_DIGEST>>
PYTHON_BASE_IMAGE=python:<<PYTHON_PATCH_TAG>>@sha256:<<PYTHON_IMAGE_DIGEST>>
N8N_IMAGE=n8nio/n8n:<<N8N_TAG>>@sha256:<<N8N_IMAGE_DIGEST>>

# --- postgres bootstrap. Consumed ONLY by the container init. --------------
# Never passed to the policy service, to demo_seed, or to n8n.
POSTGRES_BOOTSTRAP_USER=<<POSTGRES_BOOTSTRAP_USER>>           # sensitive non-secret
POSTGRES_BOOTSTRAP_PASSWORD=<<POSTGRES_BOOTSTRAP_PASSWORD>>   # SECRET

# --- host-side port. Safe. -------------------------------------------------
# The port your Mac reaches the container on. 5433 by default, because a local
# PostgreSQL commonly already holds 5432. Check with: lsof -i :5432
POSTGRES_PUBLISHED_PORT=5433
POSTGRES_HOST=localhost
POSTGRES_PORT=5433

# --- database names. Safe. -------------------------------------------------
APP_DB_NAME=bpr
N8N_DB_NAME=n8n

# --- roles. Owner runs migrations only; app is the runtime role. -----------
BPR_OWNER_USER=bpr_owner                                # sensitive non-secret
BPR_OWNER_PASSWORD=<<BPR_OWNER_PASSWORD>>               # SECRET
BPR_APP_USER=bpr_app                                    # sensitive non-secret
BPR_APP_PASSWORD=<<BPR_APP_PASSWORD>>                   # SECRET
BPR_RETENTION_USER=bpr_retention                        # sensitive non-secret
BPR_RETENTION_PASSWORD=<<BPR_RETENTION_PASSWORD>>       # SECRET
N8N_DB_USER=n8n_app                                     # sensitive non-secret
N8N_DB_PASSWORD=<<N8N_DB_PASSWORD>>                     # SECRET

# --- connection strings ----------------------------------------------------
# The service uses the app role. The owner URL is used by `make migrate` only.
# The SERVICE uses the container name and the internal port. This one is not
# affected by POSTGRES_PUBLISHED_PORT.
BPR_DATABASE_URL=postgresql://bpr_app:<<BPR_APP_PASSWORD>>@postgres:5432/bpr
BPR_OWNER_DATABASE_URL=postgresql://bpr_owner:<<BPR_OWNER_PASSWORD>>@localhost:5433/bpr

# --- service. Safe unless marked. ------------------------------------------
SERVICE_HOST=0.0.0.0
SERVICE_PORT=8000
LOG_LEVEL=INFO
INTERNAL_BEARER_TOKEN=<<INTERNAL_BEARER_TOKEN>>         # SECRET

# --- write mode. Fails closed on an unknown value (I08). -------------------
# v1 is read-only. `disabled` is the only supported value. See ADR-006.
XERO_WRITE_MODE=disabled

# --- Integration credentials. Uncomment and fill to run against Xero, Slack and Claude.
# XERO_CLIENT_ID=<<XERO_CLIENT_ID>>                     # sensitive non-secret
# XERO_CLIENT_SECRET=<<XERO_CLIENT_SECRET>>             # SECRET
# ANTHROPIC_API_KEY=<<ANTHROPIC_API_KEY>>               # SECRET
# SEMANTIC_MODEL_ID=claude-haiku-4-5-20251001          # safe
# SLACK_BOT_TOKEN=<<SLACK_BOT_TOKEN>>                   # SECRET
# SLACK_SIGNING_SECRET=<<SLACK_SIGNING_SECRET>>         # SECRET
# SEMANTIC_REVIEW_ENABLED=false                         # safe, default off

