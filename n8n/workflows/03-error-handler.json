{
  "name": "03-error-handler",
  "nodes": [
    {
      "parameters": {},
      "type": "n8n-nodes-base.errorTrigger",
      "typeVersion": 1,
      "position": [
        0,
        0
      ],
      "name": "Error Trigger",
      "id": "54c0e4be-b32f-43dc-9074-e45c444c6b1e"
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "workflow",
              "name": "workflow",
              "value": "={{ $json.workflow.name }}",
              "type": "string"
            },
            {
              "id": "execution-id",
              "name": "execution_id",
              "value": "={{ $json.execution.id }}",
              "type": "string"
            },
            {
              "id": "failed-node",
              "name": "failed_node",
              "value": "={{ $json.execution.lastNodeExecuted }}",
              "type": "string"
            },
            {
              "id": "message",
              "name": "message",
              "value": "={{ $json.execution.error.message }}",
              "type": "string"
            },
            {
              "id": "failed-at",
              "name": "failed_at",
              "value": "={{ $now.toISO() }}",
              "type": "string"
            }
          ]
        },
        "options": {}
      },
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.5,
      "position": [
        224,
        0
      ],
      "name": "Shape Failure",
      "id": "75ac60a7-5ec3-4223-9265-ad8904b69d77"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://policy_service:8000/alerts",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Idempotency-Key",
              "value": "={{ 'alert-' + $json.workflow.replace(/[^A-Za-z0-9._:-]/g, '-') + '-' + ($json.execution_id || ('handler-' + $execution.id)) + '-' + $json.failed_at.replace(/[^A-Za-z0-9._:-]/g, '-') }}"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ workflow: $json.workflow, execution_id: $json.execution_id || null, failed_node: $json.failed_node || null, message: $json.message || null, failed_at: $json.failed_at || null }) }}",
        "options": {
          "timeout": 30000
        }
      },
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.5,
      "position": [
        448,
        0
      ],
      "name": "Alert",
      "id": "5c25e648-b2b1-487a-90e7-112421fe7fde",
      "credentials": {
        "httpHeaderAuth": {
          "id": "dFDsMT7F1BU9tCTZ",
          "name": "policy service bearer"
        }
      },
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 5000
    }
  ],
  "pinData": {},
  "connections": {
    "Error Trigger": {
      "main": [
        [
          {
            "node": "Shape Failure",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Shape Failure": {
      "main": [
        [
          {
            "node": "Alert",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1",
    "binaryMode": "separate",
    "availableInMCP": true
  },
  "nodeGroups": [],
  "tags": []
}
