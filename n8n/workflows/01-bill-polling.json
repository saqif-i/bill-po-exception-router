{
  "name": "01-bill-polling",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "minutes",
              "minutesInterval": 5
            }
          ]
        }
      },
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.4,
      "position": [
        0,
        0
      ],
      "name": "Poll Schedule"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.POLICY_SERVICE_URL }}/runs/poll",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Idempotency-Key",
              "value": "={{ 'poll-' + $now.toFormat('yyyyMMddHHmm') }}"
            }
          ]
        },
        "options": {
          "timeout": 60000,
          "response": {
            "response": {
              "fullResponse": true,
              "neverError": true
            }
          }
        }
      },
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.5,
      "position": [
        224,
        0
      ],
      "name": "Poll Runs",
      "credentials": {
        "httpHeaderAuth": {
          "id": "REPLACE_AFTER_IMPORT",
          "name": "Policy service bearer"
        }
      }
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 2
          },
          "conditions": [
            {
              "id": "status-200",
              "leftValue": "={{ $json.statusCode }}",
              "rightValue": 200,
              "operator": {
                "type": "number",
                "operation": "equals"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.3,
      "position": [
        448,
        0
      ],
      "name": "Poll Succeeded"
    },
    {
      "parameters": {
        "fieldToSplitOut": "body.run_ids",
        "include": "noOtherFields",
        "options": {}
      },
      "type": "n8n-nodes-base.splitOut",
      "typeVersion": 1,
      "position": [
        672,
        -112
      ],
      "name": "Split Run IDs"
    },
    {
      "parameters": {
        "mode": "each",
        "source": "database",
        "workflowId": {
          "__rl": true,
          "mode": "list",
          "value": "REPLACE_WITH_02_WORKFLOW_ID",
          "cachedResultName": "02-bill-processing"
        },
        "workflowInputs": {
          "mappingMode": "defineBelow",
          "value": {
            "run_id": "={{ $json[\"body.run_ids\"] }}"
          },
          "matchingColumns": [],
          "schema": [
            {
              "id": "run_id",
              "displayName": "run_id",
              "required": false,
              "defaultMatch": false,
              "display": true,
              "canBeUsedToMatch": true,
              "type": "string"
            }
          ],
          "attemptToConvertTypes": false,
          "convertFieldsToString": true
        },
        "options": {}
      },
      "type": "n8n-nodes-base.executeWorkflow",
      "typeVersion": 1.3,
      "position": [
        896,
        -112
      ],
      "name": "Process Each Bill",
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose",
            "version": 2
          },
          "conditions": [
            {
              "id": "retryable",
              "leftValue": "={{ $json.statusCode === 202 || $json.statusCode === 429 || $json.statusCode >= 500 }}",
              "rightValue": "",
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.3,
      "position": [
        672,
        112
      ],
      "name": "Poll Retryable"
    },
    {
      "parameters": {},
      "type": "n8n-nodes-base.noOp",
      "typeVersion": 1,
      "position": [
        896,
        32
      ],
      "name": "Poll Retry Required"
    },
    {
      "parameters": {
        "errorMessage": "=poll failed: {{ $json.statusCode }} {{ $json.body.error }}"
      },
      "type": "n8n-nodes-base.stopAndError",
      "typeVersion": 1,
      "position": [
        896,
        192
      ],
      "name": "Poll Failed"
    }
  ],
  "connections": {
    "Poll Schedule": {
      "main": [
        [
          {
            "node": "Poll Runs",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Poll Runs": {
      "main": [
        [
          {
            "node": "Poll Succeeded",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Poll Succeeded": {
      "main": [
        [
          {
            "node": "Split Run IDs",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Poll Retryable",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Split Run IDs": {
      "main": [
        [
          {
            "node": "Process Each Bill",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Poll Retryable": {
      "main": [
        [
          {
            "node": "Poll Retry Required",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Poll Failed",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  },
  "pinData": {}
}